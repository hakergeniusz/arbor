# Maintainer: hakergeniusz <hakergeniusz@users.noreply.github.com>
# Build from a source checkout:  makepkg -p PKGBUILD  (inside packaging/arch)
# or place the release tarball next to the PKGBUILD and makepkg uses it.
pkgname=arbor
_tag=v51.0.0-beta.2
pkgver=51.0.0beta2
pkgrel=1
pkgdesc="See where your disk space grows — a disk usage analyzer"
arch=('x86_64' 'aarch64')
url="https://github.com/hakergeniusz/arbor"
license=('MIT')
depends=('gtk4>=4.10' 'libadwaita>=1.8')
makedepends=('cargo')
source=("$pkgname-$_tag.tar.gz::https://github.com/hakergeniusz/arbor/archive/refs/tags/$_tag.tar.gz")
sha256sums=('SKIP')  # replace with the tag's checksum at release time
options=('!lto' '!debug')

build() {
  cd "$pkgname-$_tag"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$_tag"
  cargo test --locked
}

package() {
  cd "$pkgname-$_tag"
  install -D -m 755 target/release/arbor "$pkgdir/usr/bin/arbor"
  install -D -m 644 data/io.github.hakergeniusz.Arbor.desktop.in \
    "$pkgdir/usr/share/applications/io.github.hakergeniusz.Arbor.desktop"
  install -D -m 644 data/io.github.hakergeniusz.Arbor.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.hakergeniusz.Arbor.metainfo.xml"
  install -D -m 644 data/icons/scalable/apps/io.github.hakergeniusz.Arbor.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.hakergeniusz.Arbor.svg"
  install -D -m 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
