#!/usr/bin/make -f
# debian/rules for arbor — plain cargo build, no dh_auto_configure.
%:
	dh $@

override_dh_auto_configure:
	# Nothing to configure; cargo handles the build.

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_test:
	cargo test --locked

override_dh_auto_install:
	install -D -m 755 target/release/arbor \
		debian/arbor/usr/bin/arbor
	install -D -m 644 data/io.github.hakergeniusz.Arbor.desktop.in \
		debian/arbor/usr/share/applications/io.github.hakergeniusz.Arbor.desktop
	install -D -m 644 data/io.github.hakergeniusz.Arbor.metainfo.xml \
		debian/arbor/usr/share/metainfo/io.github.hakergeniusz.Arbor.metainfo.xml
	install -D -m 644 data/icons/scalable/apps/io.github.hakergeniusz.Arbor.svg \
		debian/arbor/usr/share/icons/hicolor/scalable/apps/io.github.hakergeniusz.Arbor.svg
