[Desktop Entry]
Type=Application
Name=Arbor
GenericName=Disk Usage Analyzer
Comment=Check folder sizes and available disk space
Exec=arbor %U
Icon=io.github.hakergeniusz.Arbor
Terminal=false
Categories=System;FileTools;Utility;GTK;
Keywords=disk;space;usage;size;analyze;storage;
MimeType=inode/directory;
StartupNotify=true
X-Purism-FormFactor=Workstation;Mobile;
